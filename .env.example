# Copy to .env and fill in your values. .env is ignored by git.
FILAMENT_CLIENT=ollama
FILAMENT_MODEL=gemma4:31b
FILAMENT_OLLAMA_URL=https://ollama.com
FILAMENT_API_KEY=replace_me
OLLAMA_API_KEY=replace_me
FILAMENT_USE_OLLAMA=1
# Alternatively use an OpenAI-compatible provider:
# FILAMENT_CLIENT=openai
# FILAMENT_MODEL=gpt-4o-mini
# FILAMENT_OLLAMA_URL=https://api.openai.com/v1
# FILAMENT_API_KEY=sk-...
